APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_platform
JWT_SECRET=change-me
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
CONFIG_FILE_PATH=config/api_keys.yaml
CORS_ORIGINS=https://your-domain.com
ALLOWED_REGISTRATION=false
MAX_HISTORY_TOKENS=6000

# Put provider secrets in backend/config/api_keys.yaml
